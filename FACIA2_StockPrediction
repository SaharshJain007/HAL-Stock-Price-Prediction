# Determine Actual vs Predicted Directions (1 = Buy/Up, 0 = Sell/Down)
actual_dir_rnn = (y_test_dl_price > prev_close_rnn.values).astype(int)
pred_dir_rnn = (preds_rnn > prev_close_rnn.values).astype(int)

