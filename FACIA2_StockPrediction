plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

# --- Chart 3: Returns Distribution ---
plt.figure(figsize=(10, 5))
sns.histplot(df['Daily_Return'].dropna(), bins=100, kde=True, color='purple')
plt.title('Distribution of Daily Returns')
plt.xlabel('Daily Return %')
plt.show()

# Clean up: Drop the temporary columns so they don't confuse the ML models later
# We keep Daily_Return as it might be useful, but drop the MAs and Volatility
df.drop(columns=['MA_50', 'MA_200', 'Volatility_30'], inplace=True, errors='ignore')

# ==========================================
# 3. FEATURE ENGINEERING (Lookback = 90 Days)
# ==========================================
# We use 90 days of lags for ML models so they look at 2 months of context
# to predict the future, matching the DL models' sequence length.
num_lags = 90
for i in range(1, num_lags + 1):
    df[f'Lag_{i}'] = df['Close'].shift(i)

df_ml = df.dropna().copy()

features = [f'Lag_{i}' for i in range(1, num_lags + 1)]
target = 'Close'

X = df_ml[features]
y = df_ml[target]

# Train/Test Split (80% Train, 20% Test)
split_idx = int(len(X) * 0.8)
X_train, X_test = X.iloc[:split_idx], X.iloc[split_idx:]
y_train, y_test = y.iloc[:split_idx], y.iloc[split_idx:]

# Define Test Dates for Plotting
test_dates = df_ml.index[split_idx:]

# ==========================================
# 4. TRAINING ML MODELS
# ==========================================
model_performance = {}
model_predictions_test = {} # Store test predictions for plotting

def evaluate_and_store(name, y_true, y_pred):
    mae = mean_absolute_error(y_true, y_pred)
    rmse = math.sqrt(mean_squared_error(y_true, y_pred))
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    model_performance[name] = {'MAE': mae, 'RMSE': rmse, 'MAPE': mape}
    model_predictions_test[name] = y_pred # Save for graphing later
    return y_pred

print("\nTraining Machine Learning Models...")

# 1. Linear Regression
lr = LinearRegression()
lr.fit(X_train, y_train)
evaluate_and_store('Linear Regression', y_test, lr.predict(X_test))

# 2. Random Forest
rf = RandomForestRegressor(n_estimators=100, random_state=42)
rf.fit(X_train, y_train)
evaluate_and_store('Random Forest', y_test, rf.predict(X_test))

# 3. XGBoost
xgb_model = xgb.XGBRegressor(objective='reg:squarederror', n_estimators=100)
xgb_model.fit(X_train, y_train)
evaluate_and_store('XGBoost', y_test, xgb_model.predict(X_test))

# ==========================================
# 5. TRAINING DEEP LEARNING MODELS
# ==========================================
print("Training Deep Learning Models...")

scaler = MinMaxScaler(feature_range=(0, 1))
scaled_data = scaler.fit_transform(df[['Close']].values)

SEQ_LENGTH = 90 

def create_sequences(data, seq_length):
    xs, ys = [], []
    for i in range(len(data) - seq_length):
        xs.append(data[i:(i + seq_length)])
        ys.append(data[i + seq_length])
    return np.array(xs), np.array(ys)

X_dl, y_dl = create_sequences(scaled_data, SEQ_LENGTH)

# DL Split
split_dl = int(len(X_dl) * 0.8)
X_train_dl, X_test_dl = X_dl[:split_dl], X_dl[split_dl:]
y_train_dl, y_test_dl = y_dl[:split_dl], y_dl[split_dl:]

# Define DL Test Dates
test_dates_dl = df.index[split_dl + SEQ_LENGTH:]

# 4. Simple RNN
model_rnn = Sequential()
model_rnn.add(SimpleRNN(50, return_sequences=False, input_shape=(SEQ_LENGTH, 1)))
model_rnn.add(Dense(1))
model_rnn.compile(optimizer='adam', loss='mean_squared_error')
model_rnn.fit(X_train_dl, y_train_dl, epochs=50, batch_size=32, verbose=0)

pred_rnn = scaler.inverse_transform(model_rnn.predict(X_test_dl)).flatten()
# Store manually since structure is different
model_predictions_test['Simple RNN'] = pred_rnn
# Evaluate
evaluate_and_store('Simple RNN', scaler.inverse_transform(y_test_dl).flatten(), pred_rnn)

# 5. LSTM
model_lstm = Sequential()
model_lstm.add(LSTM(50, return_sequences=True, input_shape=(SEQ_LENGTH, 1)))
model_lstm.add(LSTM(50, return_sequences=False))
model_lstm.add(Dense(25))
model_lstm.add(Dense(1))
model_lstm.compile(optimizer='adam', loss='mean_squared_error')
model_lstm.fit(X_train_dl, y_train_dl, epochs=50, batch_size=32, verbose=0)

pred_lstm = scaler.inverse_transform(model_lstm.predict(X_test_dl)).flatten()
model_predictions_test['LSTM'] = pred_lstm
evaluate_and_store('LSTM', scaler.inverse_transform(y_test_dl).flatten(), pred_lstm)

# Show Error Metrics
print("\nFinal Model Comparison:")
print(pd.DataFrame(model_performance).T)

# ==========================================
# 6. FUTURE FORECASTING (30 DAYS)
# ==========================================
print("\nGenerating Future Forecasts...")
days_to_predict = 30
last_date = df.index[-1]
future_dates = pd.date_range(start=last_date + pd.Timedelta(days=1), periods=days_to_predict)
future_results = {}

# A. ML Forecasting (FIXED WARNINGS)
last_known_lags = df['Close'].tail(num_lags).values[::-1]

def forecast_ml(model, start_lags):
    forecast = []
    current = start_lags.copy()
    
    # We explicitly define the feature names to silence the warnings
    feature_names = [f'Lag_{i}' for i in range(1, num_lags + 1)]
    
    for _ in range(days_to_predict):
        # Convert the current array into a DataFrame with correct column names
        input_df = pd.DataFrame([current], columns=feature_names)
        
        # Predict using the DataFrame
        pred = model.predict(input_df)[0]
        forecast.append(pred)
        
        # Update lags
        current = np.roll(current, 1)
        current[0] = pred
    return forecast

future_results['Linear Regression'] = forecast_ml(lr, last_known_lags)
future_results['Random Forest'] = forecast_ml(rf, last_known_lags)
future_results['XGBoost'] = forecast_ml(xgb_model, last_known_lags)

# ... (Keep the rest of Section 6 (DL Forecasting) as is) ...

# B. DL Forecasting
last_60_scaled = scaled_data[-SEQ_LENGTH:]

def forecast_dl(model, start_seq):
    forecast = []
    current = start_seq.reshape((1, SEQ_LENGTH, 1))
    for _ in range(days_to_predict):
        pred = model.predict(current, verbose=0)[0]
        forecast.append(pred)
        pred_reshaped = pred.reshape((1, 1, 1))
        current = np.append(current[:, 1:, :], pred_reshaped, axis=1)
    return scaler.inverse_transform(np.array(forecast)).flatten()

future_results['Simple RNN'] = forecast_dl(model_rnn, last_60_scaled)
future_results['LSTM'] = forecast_dl(model_lstm, last_60_scaled)

# ==========================================
# 7. FINAL VISUALIZATION & REPORTING (COMPLETE)
# ==========================================

# --- STEP A: PREPARE DATA ---
forecast_df = pd.DataFrame({'Date': future_dates})
for name, data in future_results.items():
    forecast_df[name] = data

# Determine start date for plotting (Test Split - 90 days context)
plot_start_idx = max(0, split_idx - 90)
plot_start_date = df.index[plot_start_idx]
