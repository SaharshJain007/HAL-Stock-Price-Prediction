# 10. PLOT CONFUSION MATRIX (SIMPLE RNN) - FIXED
# ==========================================
print("\nPlotting Confusion Matrix for Simple RNN (Fixed)...")

# 1. Setup Data for Simple RNN
model_name = 'Simple RNN'
preds_rnn = model_predictions_test[model_name]

# Important: DL models use different test dates (test_dates_dl)
