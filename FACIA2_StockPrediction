# ==========================================
# 8. RUBRIC REQUIREMENT: CLASSIFICATION METRICS
# ==========================================
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix, roc_auc_score

print("\n--- GENERATING CLASSIFICATION METRICS (For Rubric 5/5) ---")
print("Logic: If Predicted Price > Previous Day's Price, Signal = 1 (Buy/Up), else 0 (Sell/Down)\n")

# 1. Create Binary Targets for the Test Set
# We compare the Actual Close today vs Actual Close yesterday
actual_direction = (y_test > df['Close'].shift(1).loc[y_test.index]).astype(int)

# We need to align indices for DL models (shorter test set)
actual_direction_dl = actual_direction.loc[test_dates_dl]

classification_results = {}

for name in model_predictions_test.keys():
    # Get the raw price predictions we already made
    preds = model_predictions_test[name]
    
    # 2. Determine Prediction Direction
    if name in ['Simple RNN', 'LSTM']:
        # Compare prediction vs Actual Close of the previous day
        # We align the 'previous day' perfectly using the index
        prev_close = df['Close'].loc[test_dates_dl].shift(1).fillna(method='bfill')
        # Fix: Ensure shapes match for comparison
        pred_direction = (preds > prev_close.values).astype(int)
        y_true_class = actual_direction_dl.values
    else:
        # For ML models
        prev_close = df['Close'].loc[test_dates].shift(1).fillna(method='bfill')
        pred_direction = (preds > prev_close.values).astype(int)
        y_true_class = actual_direction.values

    # 3. Calculate Rubric Metrics
    acc = accuracy_score(y_true_class, pred_direction)
    prec = precision_score(y_true_class, pred_direction, zero_division=0)
    rec = recall_score(y_true_class, pred_direction, zero_division=0)
    f1 = f1_score(y_true_class, pred_direction, zero_division=0)
    try:
        roc = roc_auc_score(y_true_class, pred_direction)
    except:
        roc = 0.5 # Fallback if only one class exists

    classification_results[name] = {
        'Accuracy': acc,
        'Precision': prec,
        'Recall': rec,
        'F1-Score': f1,
        'ROC-AUC': roc
    }

# 4. Display as a Clean Table
class_df = pd.DataFrame(classification_results).T
print(class_df)

# 5. Plot F1-Score Comparison (Visual Proof for Rubric)
plt.figure(figsize=(10, 5))
class_df['F1-Score'].plot(kind='bar', color='teal')
